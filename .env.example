# Make a local copy: cp .env.example .env
# Replace PUID/PGID with your own `id -u` and `id -g` values.
PUID=1000
PGID=1000
TZ=Etc/UTC

# Default: web interfaces are accessible only on the Docker host.
# For browser access from your trusted LAN, replace with the host's LAN IP.
WEB_BIND_IP=127.0.0.1

# Peer connections use a separate port; publishing a port does not automatically
# forward it through your router. Only allow access under your network policy.
BT_BIND_IP=0.0.0.0
BT_PORT=6881
